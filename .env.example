# CivicProof — environment variable NAMES only.
#
# Copy to `.env.local` and fill in real values there. `.env.local` is gitignored;
# this file is committed and must never contain a real secret.
#
# Nothing below is wired up yet — these are declared here so later tasks have a
# single reference. See Docs/10-TECH-STACK.md and Docs/13-SECURITY.md.

# --- Database: Neon PostgreSQL (Prisma) ---
# A PostgreSQL connection string. On Neon, use the POOLED connection string
# (its host contains "-pooler"). Read by prisma.config.ts for CLI commands and
# by lib/db/prisma.ts at runtime. Put the real value in .env.local, not here.
DATABASE_URL=

# --- Authentication: Clerk ---
# The publishable key is exposed to the browser by design; the secret key is
# server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: where Clerk's hosted flows live. Defaults match the routes in
# app/sign-in and app/sign-up, so these only need setting if you move them.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# --- AI: OpenAI (server-side calls only) ---
OPENAI_API_KEY=

# --- Evidence storage: Vercel Blob ---
# Required for evidence upload. Create a Blob store in the Vercel dashboard
# (Storage -> Blob) and copy its read/write token, or run `vercel env pull`.
# Without it, case creation still works and only the photo upload is refused.
BLOB_READ_WRITE_TOKEN=
