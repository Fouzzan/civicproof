// CivicProof — Prisma schema
//
// Implements the five-entity model defined in Docs/07-DATABASE.md:
//
//   User
//     └── Case
//           ├── Evidence
//           ├── AIAnalysis
//           └── TimelineEvent
//
// Deliberately NOT modelled (see Docs/07-DATABASE.md §10): IncidentType,
// Severity, Authority, Assignment, Complaint, Resolution, Handoff, Notification,
// AuditLog, LegalRule, Organization, PublicReport. Those are either attributes of
// a Case in the current scope or outside the MVP entirely.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The connection string lives in
// prisma.config.ts (for CLI commands such as migrate/db push) and is passed to
// PrismaClient via a driver adapter at runtime (see lib/db/prisma.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
//
// Docs/12-IMPLEMENTATION-PLAN.md Task 4 specifies enums for role, severity,
// case status, handoff status and event type. `incidentType` is deliberately
// NOT an enum there — it stays a String and is validated at the API boundary.
// ---------------------------------------------------------------------------

enum Role {
  CITIZEN
  AUTHORITY
}

/// Lifecycle of the case itself (Docs/08-API.md §3.7).
enum CaseStatus {
  CREATED
  READY_FOR_HANDOFF
  HANDED_OFF
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
}

/// Truthfulness state machine for official reporting (Docs/05-MVP.md §8).
/// CONFIRMED_SUBMISSION may ONLY be set on genuine external confirmation —
/// never because a user clicked a button (Docs/13-SECURITY.md §14).
enum HandoffStatus {
  DRAFT
  READY_FOR_OFFICIAL_HANDOFF
  HANDED_OFF
  CONFIRMED_SUBMISSION
}

/// AI-assisted suggestion, never an official or legal determination.
enum Severity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Only events that actually occurred are recorded (Docs/07-DATABASE.md §2.5).
enum TimelineEventType {
  CASE_CREATED
  AI_ANALYSIS_COMPLETED
  COMPLAINT_PREPARED
  OFFICIAL_HANDOFF
  AUTHORITY_REVIEW
  STATUS_UPDATED
  RESOLUTION_RECORDED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(CITIZEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportedCases    Case[]          @relation("CaseReporter")
  assignedCases    Case[]          @relation("CaseAuthority")
  uploadedEvidence Evidence[]      @relation("EvidenceUploader")
  recordedEvents   TimelineEvent[] @relation("TimelineActor")

  // --- Sahayak ---
  applications Application[] @relation("ApplicationApplicant")
  conversation Conversation? @relation("ConversationOwner")
}

model Case {
  id String @id @default(cuid())

  /// Citizen-facing reference, e.g. "CP-2026-000184". Unique so it can retrieve
  /// exactly one case — but it is an IDENTIFIER, NOT AN AUTHORIZATION TOKEN.
  /// Every read must still check reporterId / authorityUserId server-side
  /// (Docs/13-SECURITY.md §3, "IDOR protection").
  caseId String @unique

  /// The citizen who filed the report. Server-derived from the authenticated
  /// session — never accepted from the client.
  reporterId String
  reporter   User   @relation("CaseReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  /// Authority user authorised to handle this case, if one is assigned.
  /// Optional: a freshly created case has no authority yet.
  authorityUserId String?
  authorityUser   User?   @relation("CaseAuthority", fields: [authorityUserId], references: [id], onDelete: SetNull)

  // --- Citizen-provided facts (never overwritten by AI) ---
  incidentType     String
  description      String
  incidentDateTime DateTime?
  location         String?

  /// Drives private handling for harassment/safety reports. Server-controlled:
  /// sensitive incident types default to private even if a client sends false.
  isSensitive Boolean @default(false)

  // --- Workflow state (server-controlled) ---
  status        CaseStatus    @default(CREATED)
  handoffStatus HandoffStatus @default(DRAFT)

  // --- AI-assisted suggestions, mirrored from AIAnalysis for display/sorting ---
  severity           Severity?
  severityReason     String?
  reportingDirection String?
  reportingChannel   String?

  /// Reviewable draft. Generating a complaint is NOT submitting it.
  complaintDraft String?

  // --- Authority-recorded resolution (authority workflow only) ---
  resolutionText String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence   Evidence[]
  aiAnalysis AIAnalysis?
  timeline   TimelineEvent[]

  // Access-path indexes: the two authorization predicates in Docs/07-DATABASE.md §8.
  @@index([reporterId])
  @@index([authorityUserId])
}

model Evidence {
  id String @id @default(cuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Restrict)

  fileName String
  fileType String

  /// Pointer to object storage. The backend controls this value; a client must
  /// never supply it, and possessing it must not grant file access
  /// (Docs/13-SECURITY.md §10).
  storageReference String

  description String?

  uploadedBy String
  uploader   User   @relation("EvidenceUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([caseId])
}

model AIAnalysis {
  id String @id @default(cuid())

  /// @unique enforces the MVP's one-analysis-per-case rule
  /// (Docs/13-SECURITY.md §6, "Data integrity").
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Restrict)

  summary        String
  structuredData Json?

  /// Optional so the AI can express uncertainty instead of fabricating a value.
  severitySuggestion  Severity?
  reportingSuggestion String?

  /// Provenance for the "AI-assisted" label shown in the UI.
  modelLabel String

  createdAt DateTime @default(now())
}

model TimelineEvent {
  id String @id @default(cuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Restrict)

  eventType   TimelineEventType
  title       String
  description String?

  /// Null for system-generated events. Derived from the authenticated user —
  /// a client may never supply an actor (Docs/13-SECURITY.md §15).
  actorUserId String?
  actor       User?   @relation("TimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Timeline reads are always "events for this case, in chronological order".
  @@index([caseId, createdAt])
}

// ---------------------------------------------------------------------------
// Sahayak — government welfare scheme assistant
//
// Implements the USER / SCHEME / APPLICATION model in Docs/07-DATABASE.md on the
// existing Prisma/Neon infrastructure rather than migrating the database
// (Docs/12-IMPLEMENTATION-PLAN-TRANSITION.md §0).
//
// The CivicProof models above are left intact and unused: dropping them needs a
// destructive migration and buys the demo nothing.
// ---------------------------------------------------------------------------

/// Lifecycle of a Sahayak application.
///
/// Every state after DRAFT is SIMULATED. None of them means a real government
/// department received anything — the UI must always say so.
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// A supported welfare scheme.
///
/// This row is the ONLY authority on eligibility. The language model may read a
/// scheme through a tool, but it must never invent, edit or override one
/// (Docs/09-AI-DESIGN.md §3).
model Scheme {
  id String @id @default(cuid())

  /// Stable identifier used by the tools, e.g. "student-education-assistance".
  /// Slug rather than cuid so tool arguments are readable and debuggable.
  slug String @unique

  name    String
  summary String

  /// Citizen-service category, e.g. "EDUCATION". A String rather than a Prisma
  /// enum, matching how incidentType is handled above: the closed set is
  /// enforced by Zod at the read boundary, so adding a category is a data
  /// change rather than a migration.
  ///
  /// The default exists only so this column could be added to a table that
  /// already had a row. Every scheme the seed writes sets it explicitly.
  category String @default("AGRICULTURE")

  /// What the citizen receives, as plain-language strings.
  benefits Json @default("[]")

  /// Who the scheme is aimed at. Display and discovery context ONLY — never an
  /// input to eligibility, which reads eligibilityRules and nothing else.
  targetGroups Json @default("[]")

  /// What a real scheme of this kind would ask you to produce.
  /// INFORMATIONAL ONLY: Sahayak collects no documents, and the UI says so.
  requiredDocuments Json @default("[]")

  /// Provenance of the stored rules, shown to the citizen.
  sourceLabel String @default("Sahayak demonstration catalogue (fictional)")

  /// Incremented only when a human approves a proposed change. Nothing the
  /// model does can move it.
  version Int @default(1)

  /// When these rules were last confirmed against their source. Null means
  /// never verified, which the UI must show as such rather than implying
  /// freshness.
  lastVerified DateTime?

  /// Controlled eligibility criteria, evaluated deterministically by
  /// lib/eligibility. Shape is validated on read — never trusted blindly.
  eligibilityRules Json

  /// Fields the prepared application must contain.
  requiredFields Json

  /// Fictional demonstration scheme. Always true in the MVP, and the UI labels
  /// every scheme carrying this flag as a demo so no one mistakes it for a real
  /// entitlement (Docs/05-MVP.md §2.1).
  isDemo Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

/// A citizen's application to a scheme.
model Application {
  id String @id @default(cuid())

  /// Server-derived from the authenticated session — never accepted from the
  /// client, and every read re-checks it.
  userId String
  user   User   @relation("ApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)

  schemeId String
  scheme   Scheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)

  status ApplicationStatus @default(DRAFT)

  /// Citizen-facing reference, e.g. "DEMO-482913".
  ///
  /// Null until simulated submission: a tracking ID must never exist for an
  /// application that was not actually submitted, because its presence is what
  /// the UI treats as proof of submission.
  trackingId String? @unique

  /// Facts the citizen supplied, keyed by fact id. The latest correction wins.
  collectedFacts Json

  /// The prepared application, keyed by required field id.
  applicationData Json

  /// Last deterministic eligibility evaluation. Written only by
  /// lib/eligibility, never by the model.
  eligibilityResult Json?

  /// Set when the citizen explicitly confirms. ApplicationSubmitter refuses to
  /// submit while this is null (Docs/09-AI-DESIGN.md, safety rule 7).
  confirmedAt DateTime?
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The two access paths: "this user's applications" and "the live draft".
  @@index([userId, status])
}

/// Server-authoritative chat transcript.
///
/// The transcript lives here rather than round-tripping through the browser so
/// a client cannot forge assistant turns or tool results. Eligibility and
/// application state are read from Application, never from this transcript.
model Conversation {
  id String @id @default(cuid())

  /// One live conversation per citizen. "Start over" clears it in place.
  userId String @unique
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Restrict)

  messages Json

  /// Which catalogue this transcript was built against.
  ///
  /// A transcript carries the tool results it has already seen, including the
  /// list of schemes discovery returned at the time. When the catalogue
  /// changes, those cached results become false — and the model will keep
  /// answering from them rather than calling the tool again. Storing the
  /// composition here lets a stale transcript be discarded instead of quietly
  /// contradicting the database.
  ///
  /// Null on transcripts written before this column existed, which are treated
  /// as stale for exactly that reason.
  catalogueFingerprint String?

  /// The draft the conversation is currently working on, if any.
  activeApplicationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
